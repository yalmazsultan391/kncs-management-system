# Copy to .env.local for local development. On Vercel, set these in
# Project Settings -> Environment Variables (do NOT commit real values).
#
# Required for shared, persistent data in production:
#   Postgres connection string from Vercel Postgres, Neon, or Supabase.
#   Example (Neon/Supabase): postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Required in production: a long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: public site URL (used only for display / links).
NEXT_PUBLIC_SITE_URL=
